# ──────────────────────────────────────────────────────────────────────────
# Registry Vault — environment configuration
#
# Usage:
#   Docker / docker compose : cp .env.example .env
#     docker-compose.yml loads it via `env_file`; for a raw container use
#     `docker run --env-file .env ...`. Docker reads this file on the host and
#     injects the values as environment variables — the file itself is never
#     copied into the image, and the API does not read it from disk.
#   Local development       : cp .env.example apps/api/.env
#     The API reads apps/api/.env at startup (see app.module.ts).
#
# Note: when NODE_ENV=production (which the Docker image sets) the API ignores
# on-disk env files entirely and takes configuration only from the process
# environment.
#
# Real environment variables always take precedence over values in this file.
# Lines starting with # are comments; commented-out vars show their defaults.
# ──────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────

# Port the API listens on. Default: 3001.
# The Docker image already sets PORT=80 — leave this unset in Docker.
#PORT=3001

# Allowed CORS origin for browser requests. Default: http://localhost:3000
# Only relevant when the frontend is served from a different origin than the
# API (e.g. `pnpm dev:web`); the Docker image serves both from one origin.
#CORS_ORIGIN=http://localhost:3000

# ── Authentication ────────────────────────────────────────────────────────

# REQUIRED — secret used to sign JWT access tokens (24h expiry).
# The API will not start without it. Generate a strong random value:
#   openssl rand -base64 48
JWT_SECRET=

# REQUIRED on first start (empty database) — password for the initial admin
# account. Once any user exists, the ADMIN_* variables are ignored; manage
# users from the UI instead.
ADMIN_PASSWORD=

# Username / email for the initial admin account (first start only).
#ADMIN_USERNAME=admin
#ADMIN_EMAIL=admin@registryvault.local

# Key used to encrypt stored registry credentials (AES-256-GCM).
# Optional with SQLite: when unset, a key is auto-generated at
# <data dir>/.encryption-key next to the database, so it persists on the same
# volume as the data it protects. Set it explicitly when using PostgreSQL.
# Recommended: openssl rand -hex 32
#ENCRYPTION_KEY=

# ── Database ──────────────────────────────────────────────────────────────

# Database backend: "sqlite" (default) or "postgres".
#DB_TYPE=sqlite

# SQLite only — path to the database file. Default: ./data/registry-vault.db
# In Docker keep it under /app/data and mount a volume there
# (docker-compose.yml already maps the named volume registry-vault-data
# to /app/data).
#DB_PATH=./data/registry-vault.db

# PostgreSQL only — used when DB_TYPE=postgres.
# Note: the `pg` driver is not installed by default; add it first with
#   pnpm --filter @registry-vault/api add pg
#DB_HOST=localhost
#DB_PORT=5432
#DB_USERNAME=postgres
#DB_PASSWORD=postgres
#DB_NAME=registryvault

# ── Embedded registry and its agent ───────────────────────────────────────
#
# These matter for the two images that ship a registry alongside Registry
# Vault: kianfar/registry-vault-aio (docker-compose.aio.yml) and
# kianfar/registry-vault-registry next to kianfar/registry-vault
# (docker-compose.registry.yml). Plain kianfar/registry-vault ignores them.

# REQUIRED by both of those compose files — the registry agent's key.
# It is two things at once: the bearer token for the agent's management API
# (:5080), and the password of the service principal Registry Vault uses to
# authenticate against the registry itself (:5000). Rotating it here and
# restarting rotates both; Registry Vault re-registers the connection with the
# new key on every start.
# At least 16 characters. Generate: openssl rand -hex 24
AGENT_API_KEY=

# URL of the registry Registry Vault registers automatically at start. When it
# is unset, Registry Vault creates no connection of its own and you add one in
# the UI. The all-in-one image sets it to http://127.0.0.1:5000 already;
# docker-compose.registry.yml sets it to http://registry:5000.
#EMBEDDED_REGISTRY_URL=

# The management API of the agent in front of that registry.
# Default: http://127.0.0.1:5080
#EMBEDDED_AGENT_URL=http://127.0.0.1:5080

# The agent's service principal — the username Registry Vault authenticates
# with on :5000. Must match AGENT_SERVICE_USER on the agent side.
#AGENT_SERVICE_USER=registry-vault

# Agent-side variables (agent/README.md has them all). The images set sensible
# defaults; these are the ones worth knowing about.
# Where the agent's management API listens. The all-in-one image binds it to
# loopback so it is not reachable from outside the container; the standalone
# registry image listens on :5080 so Registry Vault can reach it over the
# container network. Publishing it to the host is a deliberate choice.
#AGENT_API_LISTEN=127.0.0.1:5080

# Public registry address inside the container. Default: :5000
#AGENT_LISTEN=:5000

# Vulnerability scanning with the Trivy binary in the image. Default: true.
#TRIVY_ENABLED=true

# Reverse proxies (nginx, Traefik, a load balancer) whose X-Forwarded-For /
# X-Forwarded-Proto the agent believes: comma-separated CIDRs or addresses.
# Default: loopback only. If TLS is terminated in front of :5000, list the
# terminator here — otherwise the registry hands out http:// upload URLs and
# every pull is attributed to the proxy's address.
#AGENT_TRUSTED_PROXIES=127.0.0.0/8,::1/128
