# ──────────────────────────────────────────────────────────────────────────
# Registry Vault — environment configuration
#
# Usage:
#   Docker / docker compose : cp .env.example .env
#     docker-compose.yml loads it via `env_file`; for a raw container use
#     `docker run --env-file .env ...`. Docker reads this file on the host and
#     injects the values as environment variables — the file itself is never
#     copied into the image, and the API does not read it from disk.
#   Local development       : cp .env.example apps/api/.env
#     The API reads apps/api/.env at startup (see app.module.ts).
#
# Note: when NODE_ENV=production (which the Docker image sets) the API ignores
# on-disk env files entirely and takes configuration only from the process
# environment.
#
# Real environment variables always take precedence over values in this file.
# Lines starting with # are comments; commented-out vars show their defaults.
# ──────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────

# Port the API listens on. Default: 3001.
# The Docker image already sets PORT=80 — leave this unset in Docker.
#PORT=3001

# Allowed CORS origin for browser requests. Default: http://localhost:3000
# Only relevant when the frontend is served from a different origin than the
# API (e.g. `pnpm dev:web`); the Docker image serves both from one origin.
#CORS_ORIGIN=http://localhost:3000

# ── Authentication ────────────────────────────────────────────────────────

# REQUIRED — secret used to sign JWT access tokens (24h expiry).
# The API will not start without it. Generate a strong random value:
#   openssl rand -base64 48
JWT_SECRET=

# REQUIRED on first start (empty database) — password for the initial admin
# account. Once any user exists, the ADMIN_* variables are ignored; manage
# users from the UI instead.
ADMIN_PASSWORD=

# Username / email for the initial admin account (first start only).
#ADMIN_USERNAME=admin
#ADMIN_EMAIL=admin@registryvault.local

# Key used to encrypt stored registry credentials (AES-256-GCM).
# Optional with SQLite: when unset, a key is auto-generated at
# <data dir>/.encryption-key next to the database, so it persists on the same
# volume as the data it protects. Set it explicitly when using PostgreSQL.
# Recommended: openssl rand -hex 32
#ENCRYPTION_KEY=

# ── Database ──────────────────────────────────────────────────────────────

# Database backend: "sqlite" (default) or "postgres".
#DB_TYPE=sqlite

# SQLite only — path to the database file. Default: ./data/registry-vault.db
# In Docker keep it under /app/data and mount a volume there
# (docker-compose.yml already maps the named volume registry-vault-data
# to /app/data).
#DB_PATH=./data/registry-vault.db

# PostgreSQL only — used when DB_TYPE=postgres.
# Note: the `pg` driver is not installed by default; add it first with
#   pnpm --filter @registry-vault/api add pg
#DB_HOST=localhost
#DB_PORT=5432
#DB_USERNAME=postgres
#DB_PASSWORD=postgres
#DB_NAME=registryvault
